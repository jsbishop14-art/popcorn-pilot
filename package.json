{
  "name": "popcorn-pilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/write-version.mjs",
    "build": "next build",
    "start": "next start -p ${PORT:-3000} -H ${HOST:-0.0.0.0}",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "migrate": "node scripts/migrate.mjs",
    "gen-types": "node scripts/gen-types.mjs",
    "seed": "node scripts/seed.mjs",
    "fake-roku": "tsx test/fake-roku/run.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.0.0",
    "@fontsource/nunito": "^5.0.0",
    "better-sqlite3": "^11.3.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@playwright/test": "^1.48.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "brighterscript": "^0.73.8",
    "brs": "^0.45.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "rooibos-roku": "^5.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
