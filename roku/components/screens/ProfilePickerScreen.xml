<component name="ProfilePickerScreen" extends="Group">
  <interface>
    <field id="data" type="assocarray" onChange="render" />
    <field id="action" type="assocarray" alwaysNotify="true" />
    <function name="handleKey" />
  </interface>
  <script type="text/brightscript" uri="ProfilePickerScreen.brs" />
  <script type="text/brightscript" uri="../lib/Ui.brs" />
  <script type="text/brightscript" uri="../lib/KeyPolicy.brs" />
</component>
