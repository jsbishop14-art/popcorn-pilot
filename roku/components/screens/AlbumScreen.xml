<?xml version="1.0" encoding="utf-8" ?>
<!-- The Family Album as a playlist item (handoff 8.3): its photos and clips, shuffled, from the hub. -->
<component name="AlbumScreen" extends="Group">
  <interface>
    <field id="data" type="assocarray" onChange="render" />
    <field id="action" type="assocarray" alwaysNotify="true" />
    <function name="handleKey" />
  </interface>
  <script type="text/brightscript" uri="AlbumScreen.brs" />
  <script type="text/brightscript" uri="../lib/Ui.brs" />
  <script type="text/brightscript" uri="../lib/KeyPolicy.brs" />
  <children>
    <Rectangle id="black" width="1920" height="1080" color="0x000000FF" />
    <Poster id="photo" width="1920" height="1080" loadDisplayMode="scaleToFit" />
    <Video id="clip" width="1920" height="1080" visible="false" />
    <Label id="note" translation="[0, 480]" width="1920" height="120" horizAlign="center" vertAlign="center" color="0xD6DDEAFF" />
    <Timer id="next" duration="8" repeat="false" />
  </children>
</component>
