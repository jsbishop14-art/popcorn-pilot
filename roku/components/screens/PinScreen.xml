<?xml version="1.0" encoding="utf-8" ?>
<!-- PIN entry on the TV (mockup TvPin): the PIN pad, picked with the arrows and OK. The PIN is checked on the hub
     and never kept on the TV. -->
<component name="PinScreen" extends="Group">
  <interface>
    <field id="data" type="assocarray" onChange="render" />
    <field id="action" type="assocarray" alwaysNotify="true" />
    <function name="handleKey" />
  </interface>
  <script type="text/brightscript" uri="PinScreen.brs" />
  <script type="text/brightscript" uri="../lib/Ui.brs" />
  <script type="text/brightscript" uri="../lib/KeyPolicy.brs" />
</component>
