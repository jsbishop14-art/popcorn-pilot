<?xml version="1.0" encoding="utf-8" ?>
<!-- Pairing (PP6): until the hub pairs this TV, the channel says how; the hub address and token can be typed by hand
     when pairing from the phone cannot reach the TV. -->
<component name="PairScreen" extends="Group">
  <interface>
    <field id="data" type="assocarray" onChange="render" />
    <field id="action" type="assocarray" alwaysNotify="true" />
    <function name="handleKey" />
  </interface>
  <script type="text/brightscript" uri="PairScreen.brs" />
  <script type="text/brightscript" uri="../lib/Ui.brs" />
  <script type="text/brightscript" uri="../lib/KeyPolicy.brs" />
</component>
